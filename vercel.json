{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/chestbox/:path*", "destination": "/api/chestbox?path=:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
